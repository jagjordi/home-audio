# Home Audio Environment Configuration
# Copy this file to .env and adjust values as needed

# Volume mount paths
# CONFIG_PATH=/mnt/user/appdata/home-audio
# FIFOS_PATH=/tmp
# PLAYLISTS_PATH=/mnt/user/appdata/home-audio/playlists

# Snapcast ports
# SNAPCAST_CONTROL_PORT=1705
# SNAPCAST_STREAM_PORT=1704
# SNAPCAST_HTTP_PORT=1780

# Mopidy port
# MOPIDY_PORT=6683
